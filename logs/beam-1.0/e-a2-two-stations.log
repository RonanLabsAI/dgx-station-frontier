model=/models/hf/reflection__Beam-1.0-501B-A23B-NVFP4 nnodes=2 tp=2 offgb=0 memf=0.85 spec=1 block=8 nograph=0 ctx=131072 seqs=16 chunk=8192 page=64 optflags='--enable-metrics --cuda-graph-max-bs-decode 16'
args: -m sglang.launch_server --model-path /model --served-model-name beam --tp 2 --attention-backend trtllm_mha --page-size 64 --context-length 131072 --max-running-requests 16 --chunked-prefill-size 8192 --mem-fraction-static 0.85 --enable-unified-memory --tool-call-parser beam --reasoning-parser beam --watchdog-timeout 1800 --speculative-algorithm DFLASH --speculative-draft-model-path /drafter --speculative-dflash-block-size 8 --nnodes 2 --node-rank 0 --dist-init-addr <rail-ip-left>:29650 --disable-custom-all-reduce --enforce-disable-flashinfer-allreduce-fusion --host 0.0.0.0 --port 8050 --enable-metrics --cuda-graph-max-bs-decode 16

